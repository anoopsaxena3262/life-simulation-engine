meta {
  name: Generation 56 is over the budget (400)
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/boards/{{boardId}}/generations/56
  body: none
  auth: none
}

tests {
  test("Generation 56 is over the budget (400)", function () {
    expect(res.status).to.equal(400);
    expect(res.body.title).to.equal("Invalid board");
    expect(res.body.detail).to.equal("Generation 56 on a board of 90000 cells exceeds the cell-generation budget of 5000000");
  });
}
