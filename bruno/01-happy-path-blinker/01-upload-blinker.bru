meta {
  name: Upload blinker
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/v1/boards
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "width": 3,
    "height": 3,
    "cells": [
      [
        false,
        false,
        false
      ],
      [
        true,
        true,
        true
      ],
      [
        false,
        false,
        false
      ]
    ]
  }
}

script:post-response {
  const loc = res.getHeader('location');
  if (loc) bru.setVar('boardId', loc.split('/').pop());
}

tests {
  test("Upload blinker", function () {
    expect(res.status).to.equal(201);
    expect(res.getHeader('location')).to.match(/\/api\/v1\/boards\/[0-9a-f-]{36}$/);
    expect(res.body.generation).to.equal(0);
    expect(res.body.cells).to.eql([[false, false, false], [true, true, true], [false, false, false]]);
  });
}
