meta {
  name: Next (second call, same answer)
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/api/v1/boards/{{boardId}}/next
  body: none
  auth: none
}

tests {
  test("Next (second call, same answer)", function () {
    expect(res.status).to.equal(200);
    expect(res.body.generation).to.equal(1);
    expect(res.body.cells).to.eql([[false, true, false], [false, true, false], [false, true, false]]);
  });
}
