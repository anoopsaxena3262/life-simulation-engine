meta {
  name: Toad upload
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/v1/boards
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "width": 6,
    "height": 4,
    "cells": [
      [
        false,
        false,
        false,
        false,
        false,
        false
      ],
      [
        false,
        false,
        true,
        true,
        true,
        false
      ],
      [
        false,
        true,
        true,
        true,
        false,
        false
      ],
      [
        false,
        false,
        false,
        false,
        false,
        false
      ]
    ]
  }
}

script:post-response {
  const loc = res.getHeader('location');
  if (loc) bru.setVar('boardId', loc.split('/').pop());
}

tests {
  test("Toad upload", function () {
    expect(res.status).to.equal(201);
    expect(res.getHeader('location')).to.match(/\/api\/v1\/boards\/[0-9a-f-]{36}$/);
  });
}
