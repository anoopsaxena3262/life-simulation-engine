meta {
  name: Plus sign final (lead-in then cycle)
  type: http
  seq: 11
}

get {
  url: {{baseUrl}}/api/v1/boards/{{boardId}}/final
  body: none
  auth: none
}

tests {
  test("Plus sign final (lead-in then cycle)", function () {
    expect(res.status).to.equal(200);
    expect(res.body.terminationKind).to.equal("CYCLE");
    expect(res.body.period).to.equal(2);
    expect(res.body.firstOccurrenceGeneration).to.equal(4);
    expect(res.body.generationsComputed).to.equal(6);
  });
}
