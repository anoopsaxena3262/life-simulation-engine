meta {
  name: Block next is unchanged
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/api/v1/boards/{{boardId}}/next
  body: none
  auth: none
}

tests {
  test("Block next is unchanged", function () {
    expect(res.status).to.equal(200);
    expect(res.body.cells).to.eql([[false, false, false, false], [false, true, true, false], [false, true, true, false], [false, false, false, false]]);
  });
}
