meta {
  name: 5x1 column next (ends die)
  type: http
  seq: 16
}

get {
  url: {{baseUrl}}/api/v1/boards/{{boardId}}/next
  body: none
  auth: none
}

tests {
  test("5x1 column next (ends die)", function () {
    expect(res.status).to.equal(200);
    expect(res.body.cells).to.eql([[false], [true], [true], [true], [false]]);
  });
}
