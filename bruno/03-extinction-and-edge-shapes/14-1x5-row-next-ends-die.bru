meta {
  name: 1x5 row next (ends die)
  type: http
  seq: 14
}

get {
  url: {{baseUrl}}/api/v1/boards/{{boardId}}/next
  body: none
  auth: none
}

tests {
  test("1x5 row next (ends die)", function () {
    expect(res.status).to.equal(200);
    expect(res.body.cells).to.eql([[false, true, true, true, false]]);
  });
}
